@model IEnumerable<Class8_CRUD.Models.User>

<h2>User List</h2>

@if (Model == null || !Model.Any())
{
    <p>No users found</p>
}
else
{
    <table border="1">
        <thead>
            <tr>
                <th>Username</th>
                <th>Email</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.username</td>
                    <td>@item.email</td>
                </tr>
            }
        </tbody>
    </table>
}